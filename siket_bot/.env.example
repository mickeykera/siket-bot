# Paste the token BotFather gave you after /newbot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your personal numeric Telegram user id — the bot DMs this id whenever
# someone sends an enquiry, applies to tutor, or requests a booking.
# Get yours by messaging @userinfobot on Telegram.
ADMIN_CHAT_ID=000000000

# Optional: where the SQLite database file is stored
DB_PATH=siket.db

# Optional: duplicate-check against the live website (see README section 6).
# Leave both blank to skip duplicate checking entirely.
SITE_API_URL=
SITE_API_KEY=
